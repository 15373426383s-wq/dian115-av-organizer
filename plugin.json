{
  "schema_version": 3,
  "id": "local.av-organizer",
  "name": "番号整理",
  "version": "1.3.1",
  "description": "番号订阅与媒体整理：插件内定时订阅、磁力/ED2K 缓存、外部资源库与馒头增量搜索；多目录整理、FFP 分辨率、AI 翻译、图片裁剪与宿主图片标记水印、可配置 NFO、演员资料同步。",
  "author": "swgzy",
  "requires": {
    "api": "3.5"
  },
  "icon": "ui/icon.svg",
  "menu": {
    "title": "番号整理",
    "order": 30
  },
  "ui": {
    "entry": "ui/page.js"
  },
  "jobs": [
    {
      "id": "organize",
      "entry": "jobs/organize.js",
      "handler": "run",
      "recover": "recover",
      "timeout_seconds": 21600,
      "interval_seconds": 1800,
      "title": "整理收件目录"
    },
    {
      "id": "probe",
      "entry": "jobs/probe.js",
      "handler": "run",
      "timeout_seconds": 300,
      "allow_overlap": true,
      "title": "测试匹配",
      "queue": false
    },
    {
      "id": "takeover",
      "entry": "jobs/takeover.js",
      "handler": "run",
      "timeout_seconds": 3600,
      "allow_overlap": true,
      "title": "接手整理失败的文件"
    },
    {
      "id": "subscriptions",
      "entry": "jobs/subscriptions.js",
      "handler": "run",
      "recover": "recover",
      "timeout_seconds": 1800,
      "interval_seconds": 60,
      "allow_overlap": true,
      "title": "搜索番号订阅"
    },
    {
      "id": "actors",
      "entry": "jobs/actors.js",
      "handler": "run",
      "recover": "recover",
      "timeout_seconds": 3600,
      "interval_seconds": 3600,
      "title": "同步演员资料"
    }
  ],
  "events": [
    {
      "event": "host",
      "job": "takeover",
      "types": [
        "library_organize_fail"
      ]
    },
    {
      "event": "message",
      "job": "subscriptions",
      "commands": [
        "av"
      ],
      "prefixes": [
        "av ",
        "AV ",
        "Av ",
        "aV ",
        "av　",
        "AV　",
        "Av　",
        "aV　"
      ]
    }
  ],
  "declared_usage": {
    "apis": [
      "GET /api/rules",
      "POST /api/rules/{id}/sync",
      "POST /api/emby-control/library/refresh",
      "GET /api/pt/sites",
      "GET /api/pt/downloaders",
      "POST /api/pt/search",
      "POST /api/pt/download",
      "POST /api/115/offline/add",
      "GET /api/115/offline/tasks",
      "GET /api/115/accounts/options",
      "GET /api/115/directories",
      "GET /api/plugin-host/emby/instances",
      "GET /api/plugin-host/emby/libraries",
      "GET /api/extensions/v3/local.av-organizer/storage/subscription_state",
      "PUT /api/extensions/v3/local.av-organizer/storage/subscription_state",
      "GET /api/extensions/v3/local.av-organizer/media/badges",
      "POST /api/extensions/v3/local.av-organizer/media/badges/read",
      "POST /api/extensions/v3/local.av-organizer/media/image",
      "POST /api/extensions/v3/local.av-organizer/media/probe",
      "POST /api/extensions/v3/local.av-organizer/ai/complete",
      "POST /api/resource-badges/match",
      "GET /api/plugin-host/emby/items",
      "PUT /api/emby-control/items/{id}/metadata",
      "POST /api/extensions/v3/local.av-organizer/media/emby-image",
      "GET /api/extensions/v3/local.av-organizer/ai/providers",
      "POST /api/emby-control/items/{id}/refresh",
      "POST /api/extensions/v3/local.av-organizer/data/sqlite",
      "POST /api/extensions/v3/local.av-organizer/media/nfo",
      "GET /api/cache/magnet/changes"
    ],
    "sites": [
      "用户配置的 JavBus / JavDB / FC2 地址",
      "AVSOX、FreeJavBT、7mmtv、Airav.io 等内置元数据来源（可停用或修改地址）",
      "用户配置的数据库 HTTP/JSON 查询接口（地址和认证头在插件内填写）",
      "宿主已配置的馒头站点与下载器（通过宿主业务接口访问）",
      "用户配置的演员资料 JSON 接口、FlareSolverr 和整理结果 Webhook",
      "AI 请求由宿主已配置的提供商执行",
      "可选公共演员资料库、Wikipedia、Gfriends 索引及用户提供的 HTML/JSON/SQLite 资料来源",
      "可选 Amazon 海报搜索、Google/DeepL/DeepLX 翻译服务"
    ],
    "files": [
      "设置里的收件目录",
      "本地整理目标或所选 STRM 规则的源目录与输出目录"
    ],
    "notifications": true,
    "risk": "移动收件目录里的视频与字幕，写入 NFO 和封面；默认跳过已有目标，用户可显式开启视频/字幕和图片覆盖；订阅启用并配置来源后自动搜索和提交 115 离线或下载器任务，会消耗对应账号的流量和存储；PT 资源仅提交下载器；可选移入独立清理目录、复制/硬链接/软链接、裁剪图片和空本地目录清理；开启 AI 会消耗宿主提供商额度；开启演员同步会补充或覆盖 Emby 演员简介与头像。",
    "triggers": [
      "Telegram av / AV 空格及 /av 消息",
      "每分钟检查插件内到期订阅；搜索周期由用户设置"
    ]
  }
}
